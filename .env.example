# Firebase Cloud Messaging — powers the push-notification opt-in on the
# homepage (src/components/NotificationOptIn.astro).
#
# Copy to .env for local development. In production these are set in the
# Netlify UI (Site configuration → Environment variables), NOT committed.
#
# All of these are public values that ship in the browser bundle — Astro only
# exposes variables prefixed with PUBLIC_ to client code. None of them are
# secrets. The service account that actually *sends* notifications lives in
# the Our Masajid app, never here.
#
# The panel renders only when every PUBLIC_FIREBASE_* value below is set, so
# a partially-configured deploy shows nothing rather than a broken button.

# Firebase console → Project settings → General → Your apps → Web app
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Firebase console → Project settings → Cloud Messaging → Web configuration →
# Web Push certificates → "Key pair". This is the VAPID public key the browser
# uses to subscribe; it is not the same as any VAPID key in the Our Masajid repo.
PUBLIC_FIREBASE_VAPID_KEY=

# Where registration tokens are sent to be subscribed to the `icrr-all` topic.
# Defaults to https://ourmasajid.com — override when testing locally.
# PUBLIC_OURMASAJID_API=http://localhost:3001

# Google Calendar — powers the event cards on the homepage and events page
# (scripts/fetch-calendar.mjs, read via src/lib/gcal.ts).
#
# Unlike the Firebase values above, these are deliberately NOT prefixed
# PUBLIC_. Astro only exposes PUBLIC_* to client code, so keeping the plain
# names means the key is used at build time and never ships in the browser
# bundle — nobody can lift it and burn through the quota. In production both
# are set in the Netlify UI (Site configuration → Environment variables).
#
# With neither set, the build falls back to content/events/*.yml alone rather
# than failing, so local development works without them.

# Calendar → Settings for the calendar → Integrate calendar → "Calendar ID".
# The calendar must have "Make available to public" enabled.
GCAL_CALENDAR_ID=

# Google Cloud console → APIs & Services → Credentials → API key, with both the
# Calendar API and the Drive API enabled and the key restricted to those two.
# The Drive API is what downloads flyer images from event attachments; each
# attached flyer must also be shared as "Anyone with the link" in Drive.
GCAL_API_KEY=
