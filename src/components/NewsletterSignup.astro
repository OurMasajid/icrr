---
// Mailchimp classic embedded form — posts directly to Mailchimp, no
// API key or backend needed since this site builds to static files.
---

<section class="py-16">
  <div class="max-w-5xl mx-auto px-4">
    <div class="event-banner flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <span class="section-eyebrow" style="color: var(--gold-400)">Stay in the Loop</span>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-white mt-1">Get event updates in your inbox.</h2>
        <p class="mt-2 text-emerald-50/80 max-w-md">Sign up for the ICRR newsletter for the latest events, programs, and announcements.</p>
      </div>
      <form
        action="https://roundrockmasjid.us12.list-manage.com/subscribe/post?u=429c5653e3594fe7e421551f5&amp;id=9d44a9d6af&amp;f_id=0035a5e0f0"
        method="post"
        name="mc-embedded-subscribe-form"
        target="_blank"
        class="relative flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0"
        novalidate
      >
        <label for="mce-EMAIL" class="sr-only">Email Address</label>
        <input type="email" name="EMAIL" id="mce-EMAIL" class="input sm:w-64" placeholder="Email address" required />
        <div aria-hidden="true" class="absolute -left-[5000px]">
          <input type="text" name="b_429c5653e3594fe7e421551f5_9d44a9d6af" tabindex="-1" value="" />
        </div>
        <button type="submit" name="subscribe" class="btn btn-gold whitespace-nowrap">Subscribe</button>
      </form>
    </div>
  </div>
</section>
